# --- databases -------------------------------------------------------------
# The v1 database is ~89 MB and is regenerated by scraping. It is an input to
# M1-T2 (watchlist seed) and M3-T3b (application migration), so it must survive
# on disk under archive/ - but it never belongs in git.
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db.bak-*

# --- personal data ---------------------------------------------------------
# The resume drives the whole match profile (M2-T0) but is not ours to publish.
data/resume.*
# The repo is public. Catch a resume dropped in under any other name too.
data/*.pdf
data/*.docx

# --- archived v1 artefacts (M0-T2) -----------------------------------------
archive/

# --- generated output ------------------------------------------------------
output/
data/shortlist.json
data/profile.derived.yaml

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- frontend (M7) ---------------------------------------------------------
node_modules/
web/dist/
web/.vite/
npm-debug.log*

# Built SPA assets ARE committed on purpose: M10-T3 requires the app to run
# from a clean Python checkout with no node toolchain present.
!src/jobscraper/web/static/

# --- editors / os ----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
