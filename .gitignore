# --- databases -------------------------------------------------------------
# The database holds your application history and ~200 MB of postings. Back it
# up; it never belongs in git (the repo is public).
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db.bak-*

# --- personal data ---------------------------------------------------------
# The resume drives the whole match profile (M2-T0) but is not ours to publish.
data/resume.*
# The repo is public. Catch a resume dropped in under any other name too.
data/*.pdf
data/*.docx

# --- archived v1 artefacts (M0-T2) -----------------------------------------
archive/

# --- generated output ------------------------------------------------------
output/
data/shortlist.json
data/profile.derived.yaml
# Logs of runs started from the web app (M11).
data/jobs/
# v1's spreadsheet tracker: personal job-search data, never in a public repo.
data/*.xlsx

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- frontend (M7) ---------------------------------------------------------
node_modules/
web/dist/
web/.vite/
npm-debug.log*

# Built SPA assets ARE committed on purpose: M10-T3 requires the app to run
# from a clean Python checkout with no node toolchain present.
!src/jobscraper/web/static/

# --- editors / os ----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
